{
  "name": "notion-wysiwyg-md",
  "displayName": "NotionMD",
  "description": "Notion-style block editor for Markdown with Notion-flavored callouts and local Notion sync. Edit .md files inline with rich blocks, drag-to-reorder, slash commands, and polished light/dark themes.",
  "version": "0.0.1",
  "publisher": "jihan",
  "license": "MIT",
  "author": {
    "name": "JIHAN",
    "email": "2jihan000@gmail.com"
  },
  "homepage": "https://github.com/2JIHAN/notion-markdown-editor-vscode-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/2JIHAN/notion-markdown-editor-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/2JIHAN/notion-markdown-editor-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F0F0F",
    "theme": "dark"
  },
  "categories": [
    "Notebooks",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "editor",
    "viewer",
    "wysiwyg",
    "block editor",
    "notion",
    "notion-style",
    "preview",
    "notes",
    "mdx"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "notionMdEditor.editor",
        "displayName": "Notion Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          },
          {
            "filenamePattern": "*.mkd"
          },
          {
            "filenamePattern": "*.mdx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "notionMdEditor.openSourceView",
        "title": "Notion Markdown Editor: Open Source View"
      },
      {
        "command": "notionMdEditor.openBlockView",
        "title": "Notion Markdown Editor: Open Block View"
      }
    ],
    "configuration": {
      "title": "Notion Markdown Editor",
      "properties": {
        "notionMdEditor.theme": {
          "type": "string",
          "enum": [
            "light",
            "sepia",
            "claude",
            "dark",
            "sync-os",
            "sync-ide",
            "auto"
          ],
          "enumDescriptions": [
            "Light — Notion-style white",
            "Sepia — warm paper",
            "Claude — soft warm tones",
            "Dark — deep neutrals",
            "Follow your operating system's light/dark mode",
            "Follow your editor's color theme",
            "(Legacy) Same as sync-ide"
          ],
          "default": "light",
          "description": "Default color theme (saved via 'Save view as default')"
        },
        "notionMdEditor.font": {
          "type": "string",
          "enum": [
            "sans",
            "serif",
            "mono"
          ],
          "default": "sans",
          "description": "Default font family"
        },
        "notionMdEditor.textSize": {
          "type": "string",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ],
          "default": "m",
          "description": "Default text size"
        },
        "notionMdEditor.pageWidth": {
          "type": "number",
          "default": 800,
          "minimum": 400,
          "maximum": 2400,
          "description": "Default page width in pixels"
        },
        "notionMdEditor.fullWidth": {
          "type": "boolean",
          "default": false,
          "description": "Default to full window width"
        },
        "notionMdEditor.alwaysDarkCode": {
          "type": "boolean",
          "default": false,
          "description": "Render code blocks with a dark background regardless of page theme"
        },
        "notionMdEditor.alwaysDarkSource": {
          "type": "boolean",
          "default": false,
          "description": "Render the raw source view with a dark background regardless of page theme"
        },
        "notionMdEditor.sourceFullWidth": {
          "type": "boolean",
          "default": false,
          "description": "Always render the source (Code) view at full window width"
        },
        "notionMdEditor.shortenCodeSnippets": {
          "type": "boolean",
          "default": false,
          "description": "Collapse long code snippets to a preview with a Show more button"
        },
        "notionMdEditor.outlineVisible": {
          "type": "boolean",
          "default": false,
          "description": "Show the outline panel (left gutter) by default"
        },
        "notionMdEditor.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Open files in read-only mode by default (disables editing)"
        },
        "notionMdEditor.sourceWordWrap": {
          "type": "boolean",
          "default": false,
          "description": "Wrap long lines in the Code (source) view instead of horizontal scrolling"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json && node esbuild.config.js",
    "watch": "concurrently \"tsc -p tsconfig.json -w\" \"node esbuild.config.js --watch\"",
    "test": "jest",
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tiptap/core": "^2.7.0",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.7.0",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.7.0",
    "@tiptap/extension-link": "^2.7.0",
    "@tiptap/extension-table": "^2.7.0",
    "@tiptap/extension-table-cell": "^2.7.0",
    "@tiptap/extension-table-header": "^2.7.0",
    "@tiptap/extension-table-row": "^2.7.0",
    "@tiptap/extension-task-item": "^2.7.0",
    "@tiptap/extension-task-list": "^2.7.0",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.7.0",
    "@types/jest": "^29.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.0.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.21.0",
    "jest": "^29.0.0",
    "lowlight": "^3.1.0",
    "markdown-it": "^12.3.2",
    "ovsx": "^0.9.0",
    "punycode": "^2.3.1",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "tiptap-markdown": "^0.8.10",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/__mocks__/fileMock.js"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.webview.json"
        }
      ]
    }
  }
}
